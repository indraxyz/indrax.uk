{
  "name": "indrax",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "react-router build && vite build --config vite.admin.config.ts && node scripts/assemble-build.mjs",
    "start": "node scripts/preview.mjs",
    "preview": "npm run build && npm run start",
    "deploy": "npm run build && wrangler deploy --config build/server/wrangler.json",
    "preview:dev": "CLOUDFLARE_ENV=dev npm run build && npm run start",
    "deploy:dev": "CLOUDFLARE_ENV=dev npm run build && wrangler deploy --config build/server/wrangler.json",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check": "npm run format:check && npm run lint && npm run type-check && npm run test && echo 'All checks passed!'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "npm run cf-typegen && react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "clean": "node scripts/clean.mjs",
    "db:up": "docker compose up -d --wait && docker compose exec -T postgres psql -U indrax -d indrax -f /docker-entrypoint-initdb.d/10-neon.sql",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx lib/db/seed.ts",
    "format": "prettier --write \"**/*.{ts,tsx,mts,js,jsx,mjs,json,jsonc,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,js,jsx,mjs,json,jsonc,css,md}\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.104.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/static-renderer": "^3.31.3",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.6",
    "cf-workers-og": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "ky": "^2.1.0",
    "lucide-react": "^1.48.0",
    "posthog-js": "^1.434.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "react-top-loading-bar": "^3.0.2",
    "reading-time": "^1.5.0",
    "rehype-parse": "^9.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    },
    "esbuild": "^0.25.10",
    "sharp": "^0.35.4",
    "js-yaml": "^4.3.2",
    "undici": "7.29.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  }
}

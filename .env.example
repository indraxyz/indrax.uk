# Analytics is opt-in. Leave these unset and PostHog never initialises: the site
# renders identically and issues no analytics request.
# Project key from PostHog > Settings > Project. Safe to expose - it is write-only.
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host. Use https://eu.i.posthog.com for an EU project.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# The origin this deployment advertises in metadata, the sitemap, and the OG card.
# Defaults to https://indrax.uk when unset; override it on preview deployments.
NEXT_PUBLIC_SITE_URL=

# --- Blog ---

# Neon Postgres, pooled connection string. Server-only: never give this a
# NEXT_PUBLIC_ prefix, and never commit a real one.
#
# Absent is a supported state. With no database the site builds and serves the
# resume exactly as before, /blog renders its empty state, and the feed and
# sitemap simply carry no articles.
#
# For local development, `npm run db:up` starts Postgres behind a Neon-protocol
# proxy (see docker-compose.yml) and this is the string it expects:
# DATABASE_URL=postgres://indrax:indrax@127.0.0.1:4444/indrax?sslmode=require
DATABASE_URL=

# The same database reached over the plain Postgres wire protocol, for drizzle-kit
# only - it does not speak Neon's HTTP protocol. Against Neon the two are the same
# host and this can be left unset. Locally it points past the proxy:
# DIRECT_DATABASE_URL=postgres://indrax:indrax@127.0.0.1:55432/indrax
DIRECT_DATABASE_URL=

# Origin that cover images are served from, once uploads exist. `isAllowedMediaUrl`
# in lib/utils/media.ts is the only gate: it accepts an https URL whose host matches
# this exactly, and nothing else. Leaving it unset keeps the image host closed
# rather than open in anticipation - covers simply do not render until it is set.
NEXT_PUBLIC_MEDIA_ORIGIN=

# --- Admin ---
#
# All five must be set for the admin to exist at all. With any of them missing,
# /admin has nothing to sign in to and the auth endpoints answer 404 - which is
# the safe direction: an unconfigured deployment is closed, not half-open.

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# The origin OAuth callbacks come back to. Defaults to NEXT_PUBLIC_SITE_URL.
BETTER_AUTH_URL=

# From a GitHub OAuth App. Its callback URL must be
# <origin>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The one account allowed to sign in, as GitHub's numeric user id - NOT a
# username. Usernames can be changed by their owner and reclaimed by someone
# else; the id cannot. Find yours with:
#   curl -s https://api.github.com/users/<your-username> | jq .id
ALLOWED_GITHUB_ID=

# --- Cover image storage (Cloudflare R2) ---
#
# Optional. Without them the upload endpoint answers 501 and covers can still be
# pasted in as a URL, subject to NEXT_PUBLIC_MEDIA_ORIGIN.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

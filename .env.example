# Consent-gated analytics. The browser sees only this enable flag and a placeholder.
# The real project token belongs only in the Worker's runtime secrets.
# See docs/posthog-gateway.md for quotas and token-rotation cutover.
ANALYTICS_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# The origin this deployment advertises in metadata, the sitemap, and the OG card.
# Defaults to https://indrax.uk when unset; override it on preview deployments.
SITE_URL=

# Optional build metadata override (YYYY-MM-DD). Defaults to the Git revision date.
# Required only when building a source archive without Git; never a runtime secret.
SITE_UPDATED_AT=

# --- Writing ---

# Neon Postgres, pooled connection string. Server-only: never add this to the
# browser-variable allowlist, and never commit a real one.
#
# Absent is a supported state. With no database the site builds and serves the
# resume exactly as before, /writing renders its empty state, and the feed and
# sitemap simply carry no articles.
#
# For local development, `npm run db:up` starts Postgres behind a Neon-protocol
# proxy (see docker-compose.yml) and this is the string it expects:
# DATABASE_URL=postgres://indrax:indrax@127.0.0.1:4444/indrax?sslmode=require
DATABASE_URL=

# The same database reached over the plain Postgres wire protocol, for drizzle-kit
# only - it does not speak Neon's HTTP protocol. Against Neon, use the direct
# endpoint here while DATABASE_URL uses the pooled endpoint. Locally it points
# past the proxy. See docs/neon-environments.md for explicit environment selection:
# DIRECT_DATABASE_URL=postgres://indrax:indrax@127.0.0.1:55432/indrax
DIRECT_DATABASE_URL=

# Optional override of the environment's R2 media origin. Browser builds default
# to media.indrax.uk (production) or dev-media.indrax.uk (dev). For npm run dev,
# set http://localhost:5173/local-media, matching the exact host/port you open.
# Local uploads remain disabled while this value is empty or mismatched.
MEDIA_ORIGIN=

# --- Admin ---
#
# All five must be set for the admin to exist at all. With any of them missing,
# /admin has nothing to sign in to and the auth endpoints answer 503 - which is
# the safe direction: an unconfigured deployment is closed, not half-open.

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# The origin OAuth callbacks come back to. Defaults to SITE_URL.
# Set http://127.0.0.1:3000 for local production preview, or the chosen local
# Vite origin during development. Copy this file to .env.local: Vite, local
# Worker bindings, seed and Drizzle tooling share that configuration.
# Preview sets its own loopback origin unless BETTER_AUTH_URL is exported.
BETTER_AUTH_URL=

# From a GitHub OAuth App. Its callback URL must be
# <origin>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The one account allowed to sign in, as GitHub's numeric user id - NOT a
# username. Usernames can be changed by their owner and reclaimed by someone
# else; the id cannot. Find yours with:
#   curl -s https://api.github.com/users/<your-username> | jq .id
ALLOWED_GITHUB_ID=

# R2 uses the MEDIA_BUCKET binding in wrangler.jsonc. No S3 credentials needed.
# Local development uses isolated local R2 storage, never the remote buckets.
